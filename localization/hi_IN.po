msgid "GUIDE_PRESTIGE_ELIGIBLE_DETAIL"
msgstr "आपका अवसर तैयार है। रीसेट करना है या नहीं, यह तय करने से पहले सर्दी II में निर्देशित ट्यूटोरियल पूरा करें।"

msgid "GUIDE_WORLD_INTRO"
