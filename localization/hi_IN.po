msgid "HELP_0"
msgstr "उत्तर की ओर खोजबीन के लिए जॉयस्टिक का उपयोग करें। छोड़ते ही पास के दुश्मनों से अपने-आप लड़ाई होगी।"

msgid "HELP_1"
msgstr "अंकुर अकेले लड़ते हैं। फ़ार्म करने के लिए उनके पास रहें; गिरे गियर को उठाने के लिए टैप करें।"

msgid "HELP_2"
msgstr "ज़मीन पर पड़े आइटम पर टैप करें। सिक्के और रत्न सीधे आपके बटुए में जाते हैं।"

msgid "HELP_3"
msgstr "नीचे अपने नए गियर पर टैप करें, फिर उसे लैस करें। आप एक पोशाक और एक हथियार पहन सकते हैं।"

msgid "HELP_4"
msgstr "उस आइटम प्रकार को मज़बूत करने के लिए एक प्रति मर्ज करें। स्टॉक शून्य होने पर भी उसकी प्रगति बनी रहती है।"

msgid "HELP_5"
msgstr "किसी दुश्मन प्रकार को खोलें और ऑटो-कलेक्ट खरीदें, ताकि फ़ार्म करते समय उसकी लूट इकट्ठा हो।"

msgid "HELP_6"
msgstr "अपना बिल्ड बढ़ाएँ, उत्तर की खोज करें और मृत्यु को हराएँ। दुनिया शुरू से खुली है।"

msgid "HELP_7"
msgstr "आपके स्थायी बोनस बने रहते हैं। और मज़बूत दौर बनाएँ और मृत्यु को फिर चुनौती दें।"

msgid "HELP_VICTORY"
msgstr "मृत्यु पराजित! फ़ार्मिंग जारी रखें या दुनिया में प्रेस्टीज कार्ड चुनें।"

msgid "HELP_PAUSED"
msgstr "रुका हुआ · इन्वेंटरी प्रबंधन उपलब्ध है। फ़ार्मिंग जारी रखने के लिए फिर शुरू करें।"

msgid "HISTORY_EMPTY"
msgstr "आपकी नई खोजें यहाँ दिखेंगी।\nपिछली दस देखने के लिए टैप करें।"

