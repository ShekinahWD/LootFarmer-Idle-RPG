msgid "GUIDE_POTION_CAPACITY_DETAIL"
msgstr "एक रसद स्लॉट खरीदें, या स्लॉट खाली करने के लिए मौजूदा रसद इस्तेमाल करें।"

msgid "GUIDE_POTION_USE"
msgstr "अपना हेल्थ पोशन इस्तेमाल करें।"

