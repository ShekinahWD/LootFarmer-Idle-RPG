msgid "TRAVEL_HELP"
msgstr "지⁠도⁠에⁠서 캠⁠프⁠를 터⁠치⁠해 부⁠활 지⁠점⁠을 선⁠택⁠하⁠세⁠요. 캠⁠프 패⁠널⁠에⁠서 해⁠금⁠해⁠도 선⁠택⁠됩⁠니⁠다. 순⁠간⁠이⁠동⁠은 없⁠습⁠니⁠다."

msgid "SPAWN_SELECT"
