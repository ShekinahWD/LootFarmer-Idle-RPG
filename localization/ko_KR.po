msgid "HELP_0"
msgstr "조⁠이⁠스⁠틱⁠으⁠로 북⁠쪽⁠을 탐⁠험⁠하⁠세⁠요. 손⁠을 떼⁠면 근⁠처⁠의 적⁠과 자⁠동⁠으⁠로 싸⁠웁⁠니⁠다."

msgid "HELP_1"
msgstr "새⁠싹⁠은 혼⁠자 싸⁠웁⁠니⁠다. 근⁠처⁠에 머⁠물⁠며 파⁠밍⁠하⁠고, 떨⁠어⁠진 장⁠비⁠를 터⁠치⁠해 획⁠득⁠하⁠세⁠요."

msgid "HELP_2"
msgstr "바⁠닥⁠의 아⁠이⁠템⁠을 터⁠치⁠하⁠세⁠요. 코⁠인⁠과 보⁠석⁠은 바⁠로 지⁠갑⁠에 들⁠어⁠갑⁠니⁠다."

msgid "HELP_3"
msgstr "아⁠래⁠의 새 장⁠비⁠를 터⁠치⁠한 뒤 장⁠착⁠하⁠세⁠요. 의⁠상⁠과 무⁠기⁠를 하⁠나⁠씩 착⁠용⁠할 수 있⁠습⁠니⁠다."

msgid "HELP_4"
msgstr "중⁠복 아⁠이⁠템⁠을 합⁠성⁠하⁠면 그 아⁠이⁠템 종⁠류⁠가 강⁠해⁠집⁠니⁠다. 재⁠고⁠가 0⁠이 되⁠어⁠도 진⁠행⁠도⁠는 유⁠지⁠됩⁠니⁠다."

msgid "HELP_5"
msgstr "적 종⁠류⁠를 열⁠고 자⁠동 수⁠집⁠을 구⁠매⁠하⁠면 파⁠밍⁠하⁠는 동⁠안 전⁠리⁠품⁠을 모⁠읍⁠니⁠다."

msgid "HELP_6"
msgstr "빌⁠드⁠를 키⁠우⁠고 북⁠쪽⁠을 탐⁠험⁠해 사⁠신⁠을 쓰⁠러⁠뜨⁠리⁠세⁠요. 세⁠계⁠는 처⁠음⁠부⁠터 열⁠려 있⁠습⁠니⁠다."

msgid "HELP_7"
msgstr "영⁠구 보⁠너⁠스⁠는 유⁠지⁠됩⁠니⁠다. 더 강⁠한 회⁠차⁠를 만⁠들⁠어 다⁠시 사⁠신⁠에⁠게 도⁠전⁠하⁠세⁠요."

msgid "HELP_VICTORY"
msgstr "사⁠신⁠을 쓰⁠러⁠뜨⁠렸⁠습⁠니⁠다! 파⁠밍⁠을 계⁠속⁠하⁠거⁠나 월⁠드⁠에⁠서 환⁠생 카⁠드⁠를 선⁠택⁠하⁠세⁠요."

msgid "HELP_PAUSED"
msgstr "일⁠시⁠정⁠지 · 인⁠벤⁠토⁠리⁠를 관⁠리⁠할 수 있⁠습⁠니⁠다. 계⁠속⁠하⁠려⁠면 재⁠개⁠하⁠세⁠요."

msgid "HISTORY_EMPTY"
msgstr "최⁠근 획⁠득⁠한 아⁠이⁠템⁠이 여⁠기⁠에 표⁠시⁠됩⁠니⁠다.\n터⁠치⁠하⁠면 최⁠근 10⁠개⁠를 봅⁠니⁠다."

