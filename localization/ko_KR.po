msgid "FOCUS_HELP"
msgstr "적 종⁠류⁠별⁠로 파⁠밍⁠을 해⁠금⁠한 뒤 의⁠상⁠만, 무⁠기⁠만 또⁠는 둘 다⁠를 선⁠택⁠하⁠세⁠요. 쓰⁠러⁠지⁠면 그 캠⁠프⁠로 돌⁠아⁠갑⁠니⁠다. 직⁠접 이⁠동⁠하⁠면 파⁠밍⁠이 취⁠소⁠됩⁠니⁠다."

msgid "FOCUS_GROUP"
