msgid "PRESTIGE_COUNT"
msgstr "환⁠생 횟⁠수: %d"

msgid "NO_OFFLINE"
msgstr "진⁠행 상⁠황⁠은 저⁠장⁠되⁠었⁠습⁠니⁠다. 오⁠프⁠라⁠인 보⁠상⁠은 정⁠식 버⁠전⁠에⁠서 제⁠공⁠될 예⁠정⁠이⁠며, 이 빌⁠드⁠는 종⁠료 중⁠이⁠나 백⁠그⁠라⁠운⁠드 상⁠태⁠에⁠서 진⁠행⁠을 계⁠산⁠하⁠지 않⁠습⁠니⁠다."

msgid "SAVE_NOW"
msgstr "지⁠금 저⁠장"

msgid "HARD_RESET"
msgstr "완⁠전 초⁠기⁠화"

msgid "RESET_CONFIRM"
msgstr "진⁠행 상⁠황, 인⁠벤⁠토⁠리, 자⁠동⁠화, 환⁠생 카⁠드⁠를 모⁠두 지⁠울⁠까⁠요? 설⁠정⁠은 유⁠지⁠됩⁠니⁠다. 이 작⁠업⁠은 되⁠돌⁠릴 수 없⁠습⁠니⁠다."

msgid "LANGUAGE_NOTE"
msgstr "개⁠발 중⁠에⁠는 영⁠어⁠만 사⁠용⁠할 수 있⁠습⁠니⁠다. 나⁠머⁠지 19⁠개 언⁠어⁠는 번⁠역 검⁠증 후 열⁠립⁠니⁠다."

msgid "CREDITS"
msgstr "캐⁠릭⁠터 및 월⁠드 아⁠트: Pixel Plains (SnowHex). 인⁠터⁠페⁠이⁠스: Kenney Fantasy UI Borders (CC0)."

msgid "PRESTIGE_EXPLAIN"
msgstr "영⁠구 +5% 카⁠드 1⁠장⁠을 선⁠택⁠하⁠세⁠요. 보⁠너⁠스⁠는 회⁠차⁠를 거⁠듭⁠하⁠며 누⁠적⁠됩⁠니⁠다. 이 패⁠널⁠을 닫⁠고 계⁠속 파⁠밍⁠해⁠도 됩⁠니⁠다."

msgid "PRESTIGE_CONFIRM"
msgstr "이 영⁠구 카⁠드⁠로 새 회⁠차⁠를 시⁠작⁠할⁠까⁠요? 화⁠폐, 인⁠벤⁠토⁠리, 아⁠이⁠템 합⁠성 및 추⁠가 능⁠력⁠치, 적 파⁠밍 강⁠화, 캠⁠프⁠가 초⁠기⁠화⁠됩⁠니⁠다. 공⁠개⁠된 적 정⁠보, 자⁠동⁠화 레⁠벨, 인⁠벤⁠토⁠리 용⁠량, 모⁠든 환⁠생 카⁠드⁠는 유⁠지⁠됩⁠니⁠다."

msgid "CARD_DAMAGE"
msgstr "피⁠해 +5% · 영⁠구"

msgid "CARD_HP"
