msgid "GUIDE_BASIC_TARGET_DETAIL"
msgstr "Проведи пальцем від героя до ворога й відпусти, щоб обрати його ціллю. Ти атакуватимеш вибраного ворога."

msgid "GUIDE_TARGET"
msgstr "Обери ворога ціллю"

msgid "GUIDE_TARGET_DETAIL"
msgstr "Проведи пальцем від героя до ворога й відпусти, щоб обрати його ціллю. Ти атакуватимеш вибраного ворога."

msgid "GUIDE_TARGET_FIND"
