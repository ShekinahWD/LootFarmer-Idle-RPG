[gd_scene format=3]
[node name="InfoCard" type="PanelContainer"]
theme_type_variation=&"Card"
size_flags_horizontal=3
[node name="Content" type="VBoxContainer" parent="."]
theme_override_constants/separation=10
[node name="Header" type="HBoxContainer" parent="Content"]
theme_override_constants/separation=14
[node name="Icon" type="TextureRect" parent="Content/Header"]
custom_minimum_size=Vector2(48,48)
expand_mode=1
stretch_mode=5
texture_filter=1
[node name="Title" type="Label" parent="Content/Header"]
size_flags_horizontal=3
autowrap_mode=2
theme_override_font_sizes/font_size=23
[node name="Body" type="Label" parent="Content"]
autowrap_mode=2
theme_override_font_sizes/font_size=19
[node name="Progress" type="ProgressBar" parent="Content"]
custom_minimum_size=Vector2(0,14)
theme_type_variation=&"XP"
show_percentage=false
visible=false
[node name="Rewards" type="HBoxContainer" parent="Content"]
theme_override_constants/separation=12
visible=false
