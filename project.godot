; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LootFarmer - Idle RPG"
config/version="27"
config/quit_on_go_back=false
run/main_scene="res://scenes/game/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/branding/launcher_192.png"

[autoload]

BootContext="*res://scripts/autoload/boot_context.gd"
LayoutService="*res://scripts/autoload/layout_service.gd"
NumberFormat="*res://scripts/autoload/number_format.gd"
SettingsState="*res://scripts/autoload/settings_state.gd"
AudioService="*res://scripts/autoload/audio_service.gd"
SaveService="*res://scripts/autoload/save_service.gd"
LocalizationService="*res://scripts/autoload/localization_service.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://localization/en.po")

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
